# Used server-side (app/page.tsx -> lib/spacetimedb-server.ts, a Server Component)
SPACETIMEDB_DB_NAME=prompt-wars
SPACETIMEDB_HOST=ws://localhost:3000

# Used client-side (must be NEXT_PUBLIC_ to be readable in the browser bundle)
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=prompt-wars
NEXT_PUBLIC_SPACETIMEDB_HOST=ws://localhost:3000

# The real deployed origin (used for og:image/twitter:image absolute URLs).
# On Vercel this is optional — falls back to the platform's own VERCEL_URL —
# but set it explicitly once you have a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
